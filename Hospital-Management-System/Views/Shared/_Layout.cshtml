<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital_Management_System</title>

    <script type="importmap"></script>

   
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hospital_Management_System.styles.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

            <div class="container">

             
                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-hospital-fill text-primary fs-2 me-2"></i>

                    <span class="fw-bold fs-4">
                        Hospital System
                    </span>

                </a>

             
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                 
                    <ul class="navbar-nav ms-4">

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door-fill me-1"></i>
                                Home

                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav ms-auto d-flex flex-row gap-2">

                        <li class="nav-item">

                            <a class="btn btn-primary"
                               asp-controller="Appointment"
                               asp-action="Index">

                                <i class="bi bi-calendar-plus me-1"></i>
                                Book Appointment

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="btn btn-success"
                               asp-controller="Appointment"
                               asp-action="reservation">

                                <i class="bi bi-card-list me-1"></i>
                                All Appointments

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <main class="container py-4">

        @RenderBody()

    </main>

    <footer class="footer border-top text-muted py-3">

        <div class="container text-center">

            &copy; 2026 - Hospital Management System |
            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>

  
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>